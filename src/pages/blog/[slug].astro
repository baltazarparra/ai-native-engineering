---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import {
  getPublishedPosts,
  getBlogPostAlternateLinks,
  getBlogReferences,
  getBlogSeriesContext,
  type BlogEntry,
} from '../../lib/blog';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts('pt-BR');

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
};

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const [alternateLinks, series, referenceEntries] = await Promise.all([
  getBlogPostAlternateLinks(post),
  getBlogSeriesContext(post),
  getBlogReferences(post),
]);
const references = referenceEntries.map((reference) => ({
  id: reference.id,
  ...reference.data,
}));
---

<BlogPostLayout
  title={post.data.title}
  slug={post.data.slug}
  lang={post.data.lang}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  tags={post.data.tags}
  alternateLinks={alternateLinks}
  series={series}
  references={references}
>
  <Content />
</BlogPostLayout>
